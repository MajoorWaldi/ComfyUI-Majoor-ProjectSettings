{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noCheck": false,
    "noEmit": true,
    "declaration": false,
    "sourceMap": false,
    "strict": true,
    "noImplicitAny": true,
    "useUnknownInCatchVariables": true
  },
  "include": [
    "src/**/*.ts",
    "src/**/*.d.ts"
  ]
}
